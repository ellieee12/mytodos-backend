generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model mytodos_task {
  task_id      Int          @default(autoincrement())
  name         String
  done         Boolean?
  user_id      Int
  mytodos_user mytodos_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, user_id])
}

model mytodos_user {
  user_id      Int            @id @default(autoincrement())
  first_name   String
  last_name    String?
  email        String         @unique
  pwd          String
  mytodos_task mytodos_task[]
}
